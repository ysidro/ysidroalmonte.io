---
interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const p = lang === 'es' ? '/es' : '';

const nav = lang === 'es'
  ? [
      { label: 'Proyectos', href: `${p}/work/` },
      { label: 'IA', href: `${p}/#ai-workflow` },
      { label: 'Mobile', href: `${p}/mobile/` },
      { label: 'Experiencia', href: `${p}/#experience` },
      { label: 'Sobre mí', href: `${p}/about/` },
    ]
  : [
      { label: 'Work', href: '/work/' },
      { label: 'AI Workflow', href: '/#ai-workflow' },
      { label: 'Mobile', href: '/mobile/' },
      { label: 'Experience', href: '/#experience' },
      { label: 'About', href: '/about/' },
    ];

const talk = lang === 'es' ? 'Hablemos' : 'Let’s talk';

// Current path minus locale prefix, used to compute the equivalent URL in the other language.
const currentPath = Astro.url.pathname;
const basePath = currentPath.replace(/^\/es\/?/, '/');
const switchHref = lang === 'es' ? basePath : '/es' + (basePath === '/' ? '/' : basePath);
const switchLabel = lang === 'es' ? 'EN' : 'ES';
---
<header class="site-header">
  <div class="wrap bar">
    <a href={lang === 'es' ? '/es/' : '/'} class="wordmark" aria-label="Ysidro Almonte, home">
      <img src="/apple-touch-icon.jpg" alt="" width="32" height="32" />
      <span>Ysidro Almonte</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <div class="header-actions">
      <a class="lang-switch" href={switchHref} aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a español'}>{switchLabel}</a>
      <a class="btn btn-primary header-cta" href={`${p}/contact/`}>{talk}</a>
      <button type="button" class="nav-toggle" aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'} aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href={`${p}/contact/`}>{talk}</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = document.body.classList.toggle('mobile-nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  mobileNav?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      document.body.classList.remove('mobile-nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
