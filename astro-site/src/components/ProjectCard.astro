---
interface Props {
  slug: string;
  name: string;
  summary: string;
  role: string;
  stack: string[];
  results: string[];
  githubUrl?: string;
  liveUrl?: string;
  basePath: string;
}
const { slug, name, summary, role, stack, results, githubUrl, liveUrl, basePath } = Astro.props;
---

<article class="flex flex-col gap-3 rounded-lg border border-ink-300 bg-ink-100 p-6">
  <h3 class="font-serif text-xl font-semibold text-ink-900">{name}</h3>
  <p class="text-sm text-ink-700">{summary}</p>
  <p class="font-mono text-xs uppercase tracking-wide text-ink-500">{role}</p>

  <ul class="flex flex-wrap gap-1.5">
    {stack.map((tech) => (
      <li class="rounded bg-teal-100 px-2 py-0.5 font-mono text-xs text-teal-600">{tech}</li>
    ))}
  </ul>

  {results.length > 0 && (
    <p class="text-sm text-ink-700"><strong class="text-ink-900">Result:</strong> {results[0]}</p>
  )}

  <div class="mt-2 flex flex-wrap items-center gap-4 border-t border-ink-300 pt-3 text-sm">
    {githubUrl && <a href={githubUrl} target="_blank" rel="noopener" class="text-ink-700 hover:text-ink-900">GitHub ↗</a>}
    {liveUrl && <a href={liveUrl} target="_blank" rel="noopener" class="text-ink-700 hover:text-ink-900">Live ↗</a>}
    <a href={`${basePath}${slug}/`} class="ml-auto font-semibold text-accent-600 hover:text-accent-900">View Case Study →</a>
  </div>
</article>
