---
import { person } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer section-shell">
  <div>
    <p>&copy; {year} {person.fullName}</p>
    <div class="flex gap-4">
      <a href={person.links.linkedin} target="_blank" rel="noopener" class="hover:text-ink-900">LinkedIn</a>
      <a href={person.links.github} target="_blank" rel="noopener" class="hover:text-ink-900">GitHub</a>
      <a href={`mailto:${person.email}`} class="hover:text-ink-900">{person.email}</a>
    </div>
  </div>
</footer>
