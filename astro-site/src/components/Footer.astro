---
import { person } from '../data/site';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();

const colophon = lang === 'es'
  ? `© ${year} ${person.fullName}. Ingeniero senior de WordPress y PHP, República Dominicana.`
  : `© ${year} ${person.fullName}. Senior WordPress and PHP engineer, Dominican Republic.`;
---

<footer class="site-footer">
  <div class="wrap">
    <p>{colophon}</p>
    <nav aria-label={lang === 'es' ? 'Contacto' : 'Contact'}>
      <a class="link" href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="link" href={person.links.github} target="_blank" rel="noopener">GitHub</a>
      <a class="link" href={`mailto:${person.email}`}>{person.email}</a>
    </nav>
  </div>
</footer>
