---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { mobileIntro, mobileProjects } from '../../data/site';
---

<Layout
  title={`${mobileIntro.headline} — Ysidro Almonte`}
  description="Mobile and API engineering with Flutter, Dart, and Go — beyond the WordPress/PHP core."
  path="/mobile/"
>
  <Header />
  <main class="mx-auto max-w-4xl px-6 py-14">
    <p class="font-mono text-xs uppercase tracking-wide text-violet-600">{mobileIntro.eyebrow}</p>
    <h1 class="mt-2 font-serif text-3xl font-semibold text-ink-900">{mobileIntro.headline}</h1>
    <p class="mt-3 max-w-2xl text-ink-700">{mobileIntro.body}</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {mobileProjects.map((app) => (
        <article class="rounded-lg border border-ink-300 bg-ink-100 p-5">
          <div class="flex items-center justify-between">
            <h2 class="font-serif text-lg font-semibold text-ink-900">{app.name}</h2>
            <span class="rounded bg-violet-100 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-violet-600">
              {app.status}
            </span>
          </div>
          <p class="mt-1 text-xs font-mono uppercase tracking-wide text-ink-500">{app.category}</p>
          <p class="mt-2 text-sm text-ink-700">{app.description}</p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {app.stack.map((tech) => (
              <li class="rounded bg-teal-100 px-2 py-0.5 font-mono text-xs text-teal-600">{tech}</li>
            ))}
          </ul>
          <div class="mt-4 flex gap-4 text-sm">
            <a href={app.url} target="_blank" rel="noopener" class="ml-auto font-semibold text-violet-600 hover:text-violet-900">
              Visit site ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
