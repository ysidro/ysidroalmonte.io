---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { hero, proof, expertise, experience, about, closing, person } from '../data/site';

const projects = [
  { number: '01', name: 'M Voy', type: 'Mobile product · Flutter', description: 'A two-sided mobility experience with dedicated passenger and driver flows — from requesting a ride to receiving and accepting driver offers.', url: 'https://mvoyrd.com/', accent: 'yellow', images: ['/images/work/mvoy/user-onboarding.png', '/images/work/mvoy/user-map.png', '/images/work/mvoy/user-offer.png'], stack: ['Flutter', 'Dart', 'REST APIs', 'Maps', 'Geolocation'] },
  { number: '02', name: 'CreaThink Tools', type: 'Independent product · Browser SaaS', description: 'A privacy-first suite for everyday image and QR tasks. The product, interface, client-side processing and paid access were built as one coherent system.', url: 'https://creathinktools.com/', accent: 'violet', image: '/images/work/featured/mvoy-landing.png', stack: ['Cloudflare Workers', 'D1', 'Paddle', 'Client-side processing'] },
  { number: '03', name: 'Acrylic Photo Print', type: 'E-commerce · Product personalization', description: 'A custom WooCommerce storefront where customers upload, preview and personalize photography products through a purpose-built purchasing flow.', url: 'https://acrylicphotoprint.com/', accent: 'cyan', image: '/images/work/featured/acrylic-photo-print.png', caseStudy: '/work/acrylicphotoprint/', stack: ['WordPress', 'WooCommerce', 'Timber', 'Svelte', 'AWS'] },
  { number: '04', name: 'Chevrolet', type: 'Automotive · Headless CMS', description: 'A high-traffic automotive experience using WordPress as a structured content source and Gatsby to deliver fast, optimized customer-facing pages.', url: 'https://chevrolet.com.do/', accent: 'gold', image: '/images/work/featured/chevrolet.png', stack: ['Gatsby', 'React', 'WordPress', 'WPGraphQL'] },
  { number: '05', name: 'Seer', type: 'Biotechnology · Corporate platform', description: 'A custom WordPress and ACF implementation that turns complex proteomics content into a structured, maintainable marketing platform.', url: 'https://seer.bio/', accent: 'blue', image: '/images/work/featured/seer-bio.png', stack: ['WordPress', 'ACF', 'PHP', 'Custom theme'] },
];
---

<Layout title="Ysidro Almonte — Senior WordPress / PHP Engineer" description="Senior engineer building high-performance WordPress platforms, mobile products, and digital tools." path="/">
  <Header />
  <main>
    <section class="hero-shell section-shell" data-reveal>
      <div class="hero-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow"><span class="status-dot"></span>{hero.eyebrow}</p>
      <h1>I engineer digital products that feel <em>clear, fast,</em> and distinctly human.</h1>
      <div class="hero-bottom">
        <p>{hero.subhead}</p>
        <div class="hero-actions"><a class="button button-primary" href="#selected-work">Explore selected work <span>↘</span></a><a class="text-link" href={person.links.resume} target="_blank" rel="noopener">Résumé ↗</a></div>
      </div>
      <div class="hero-meta"><span>WordPress / PHP</span><span>Product engineering</span><span>Dominican Republic</span></div>
    </section>

    <section id="selected-work" class="work-intro section-shell" data-reveal>
      <div><p class="section-index">01 / Selected work</p><h2>Selected systems,<br /><em>not just screens.</em></h2></div>
      <p>Client platforms and independent products presented through the decisions, flows and engineering behind them.</p>
    </section>

    <section class="projects section-shell" aria-label="Selected projects">
      {projects.map((project) => (
        <article class={`project project-${project.accent}`} data-reveal>
          <div class="project-copy">
            <div class="project-kicker"><span>{project.number}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3><p>{project.description}</p>
            <ul>{project.stack.map((tech) => <li>{tech}</li>)}</ul>
            <div class="project-links">{project.caseStudy && <a href={project.caseStudy}>Read case study <span>↗</span></a>}<a href={project.url} target="_blank" rel="noopener">Visit project <span>↗</span></a></div>
          </div>
          <div class={`project-visual ${project.images ? 'phone-stage' : 'browser-stage'}`}>
            {project.images ? project.images.map((src, imageIndex) => <img src={src} alt={`${project.name} application screen ${imageIndex + 1}`} loading={project.number === '01' ? 'eager' : 'lazy'} width="946" height="2048" />) : <div class="browser-frame"><span class="browser-bar"><i></i><i></i><i></i></span><img src={project.image} alt={`${project.name} website`} loading="lazy" /></div>}
          </div>
        </article>
      ))}
    </section>

    <section class="proof-section section-shell" data-reveal><p class="section-index">02 / Track record</p><div class="proof-grid">{proof.slice(0, 4).map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section>

    <section class="capabilities section-shell" data-reveal><div class="capabilities-heading"><p class="section-index">03 / Capabilities</p><h2>From architecture<br />to the <em>last detail.</em></h2></div><div class="capability-list">{expertise.map((category, index) => <details open={index === 0}><summary><span>0{index + 1}</span>{category.name}<i>+</i></summary><div>{category.stack.map((tech) => <span>{tech}</span>)}</div></details>)}</div></section>

    <section id="experience" class="experience section-shell" data-reveal><p class="section-index">04 / Experience</p><div class="experience-layout"><h2>Built across agencies,<br />products and <em>teams.</em></h2><ol>{experience.map((job) => <li><span>{job.period}</span><div><h3>{job.company}</h3><p>{job.role}</p></div></li>)}</ol></div></section>

    <section class="about-section section-shell glass-panel" data-reveal><p class="section-index">05 / About</p><p class="about-lead">Engineering with a product lens.</p><p>{about.paragraph}</p></section>

    <section class="closing section-shell" data-reveal><p class="eyebrow">Available for selected opportunities</p><h2>Have something<br /><em>worth building?</em></h2><p>{closing.body}</p><a class="button button-primary" href="/contact/">Start a conversation <span>↗</span></a></section>
  </main>
  <Footer />
</Layout>
