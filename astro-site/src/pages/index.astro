---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { hero, proof, expertise, experience, about, closing, person, aiWorkflow } from '../data/site';

// WordPress/PHP work leads the homepage — this is a WordPress engineer's
// portfolio, so the first things a visitor sees must prove that, not the
// mobile/product work (which still gets its own section further down).
const projects = [
  { number: '01', name: 'Acrylic Photo Print', type: 'E-commerce · Product personalization', description: 'A custom WooCommerce storefront where customers upload, preview and personalize photography products through a purpose-built purchasing flow.', url: 'https://acrylicphotoprint.com/', accent: 'cyan', image: '/images/work/featured/acrylic-photo-print.png', caseStudy: '/work/acrylicphotoprint/', stack: ['WordPress', 'WooCommerce', 'Timber', 'Svelte', 'AWS'] },
  { number: '02', name: 'Real Estate API Sync', type: 'WordPress backend · Data sync', description: 'A custom WordPress integration that keeps property listings synchronized from external real estate APIs, replacing manual entry with structured Custom Post Types.', githubUrl: 'https://github.com/ysidro/real-estate-sync/tree/main', accent: 'lime', caseStudy: '/work/real-estate-api-sync/', diagram: '/images/work/diagrams/real-estate-api-sync.svg', stack: ['PHP', 'WordPress', 'WP REST API', 'MySQL'] },
  { number: '03', name: 'Woo Payment Gateway', type: 'WooCommerce · Payments', description: 'A custom WooCommerce payment gateway built for the Dominican Republic market, with secure server-to-server transaction confirmation.', githubUrl: 'https://github.com/ysidro/WooCommerce-CardNet-Payment-Gateway-Dominican-Republic-/blob/main/readme.md', accent: 'rose', caseStudy: '/work/woo-payment-gateway/', diagram: '/images/work/diagrams/woo-payment-gateway.svg', stack: ['PHP', 'WooCommerce', 'Payment APIs'] },
  { number: '04', name: 'Chevrolet', type: 'Automotive · Headless CMS', description: 'A high-traffic automotive experience using WordPress as a structured content source and Gatsby to deliver fast, optimized customer-facing pages.', url: 'https://chevrolet.com.do/', accent: 'gold', image: '/images/work/featured/chevrolet.png', stack: ['Gatsby', 'React', 'WordPress', 'WPGraphQL'] },
  { number: '05', name: 'Seer', type: 'Biotechnology · Corporate platform', description: 'A custom WordPress and ACF implementation that turns complex proteomics content into a structured, maintainable marketing platform.', url: 'https://seer.bio/', accent: 'blue', image: '/images/work/featured/seer-bio.png', stack: ['WordPress', 'ACF', 'PHP', 'Custom theme'] },
];

// Mobile / independent products — real engineering range, but kept compact
// and visually quieter than the WordPress work above, exactly as before.
const beyondWordpress = [
  { name: 'M Voy', type: 'Mobile · Flutter', description: 'Two-sided mobility app — passenger and driver flows, maps, geolocation.', url: '/mobile/', image: '/images/work/mvoy/user-onboarding.png' },
  { name: 'CreaThink Tools', type: 'Browser SaaS · Next.js', description: 'Privacy-first image and QR tools, processed entirely on-device.', url: 'https://creathinktools.com/', image: '/images/work/featured/creathink-tools.png' },
];
---

<Layout title="Ysidro Almonte — Senior WordPress / PHP Engineer" description="Senior WordPress and PHP engineer building custom plugins, WooCommerce systems, API integrations, and AI-assisted digital products for agencies and remote teams." path="/">
  <Header />
  <main>
    <section class="hero-shell section-shell" data-reveal>
      <div class="hero-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow"><span class="status-dot"></span>{hero.eyebrow}</p>
      <h1>Senior WordPress engineering, <em>accelerated by AI</em> and grounded in judgment.</h1>
      <div class="hero-bottom">
        <p>{hero.subhead}</p>
        <div class="hero-actions"><a class="button button-primary" href="#selected-work">Explore selected work <span>↘</span></a><a class="text-link" href={person.links.resume} target="_blank" rel="noopener">Résumé ↗</a></div>
      </div>
      <div class="hero-meta"><span>WordPress / PHP</span><span>AI-assisted delivery</span><span>Dominican Republic</span></div>
    </section>

    <section id="selected-work" class="work-intro section-shell" data-reveal>
      <div><p class="section-index">01 / WordPress engineering</p><h2>Selected systems,<br /><em>not just screens.</em></h2></div>
      <p>Production WordPress and WooCommerce platforms, presented through the decisions, flows and engineering behind them.</p>
    </section>

    <section class="projects section-shell" aria-label="Selected projects">
      {projects.map((project) => (
        <article class={`project project-${project.accent}`} data-reveal>
          <div class="project-copy">
            <div class="project-kicker"><span>{project.number}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3><p>{project.description}</p>
            <ul>{project.stack.map((tech) => <li>{tech}</li>)}</ul>
            <div class="project-links">
              {project.caseStudy && <a href={project.caseStudy}>Read case study <span>↗</span></a>}
              {project.githubUrl && <a href={project.githubUrl} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
              {project.url && <a href={project.url} target="_blank" rel="noopener">Visit project <span>↗</span></a>}
            </div>
          </div>
          <div class={`project-visual ${project.image ? 'browser-stage' : project.diagram ? 'diagram-stage' : 'visual-mark'}`}>
            {project.image ? (
              <div class="browser-frame"><span class="browser-bar"><i></i><i></i><i></i></span><img src={project.image} alt={`${project.name} website`} loading="lazy" /></div>
            ) : project.diagram ? (
              <img src={project.diagram} alt={`${project.name} architecture diagram`} loading="lazy" />
            ) : (
              <>
                <span>{project.stack[0]}</span>
                <small>No public screenshot — see case study</small>
              </>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="section-shell" style="padding:80px 0 120px" data-reveal>
      <p class="section-index">Beyond WordPress</p>
      <h2 style="margin:18px 0 12px;font-size:clamp(28px,4vw,44px);line-height:1.05;letter-spacing:-.03em;font-weight:500">Mobile &amp; independent products</h2>
      <p class="lead" style="margin-bottom:40px;max-width:560px">Engineering range outside the CMS core — kept intentionally brief here. <a href="/mobile/" style="color:#d9d3ff;border-bottom:1px solid rgba(217,211,255,.4)">See the full mobile work ↗</a></p>
      <div style="display:grid;gap:20px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))">
        {beyondWordpress.map((item) => (
          <a href={item.url} target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener' : undefined} class="row-card" style="display:block">
            <img src={item.image} alt={item.name} loading="lazy" width="900" height="600" style="height:130px" />
            <p class="section-index" style="margin:0">{item.type}</p>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="proof-section section-shell" data-reveal><p class="section-index">02 / Track record</p><div class="proof-grid">{proof.slice(0, 4).map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section>

    <section id="ai-workflow" class="ai-workflow section-shell" data-reveal>
      <div class="ai-workflow-heading">
        <p class="section-index">03 / {aiWorkflow.eyebrow}</p>
        <h2>{aiWorkflow.headline}</h2>
        <p>{aiWorkflow.body}</p>
        <strong>{aiWorkflow.note}</strong>
      </div>
      <ol>
        {aiWorkflow.stages.map((stage) => (
          <li>
            <span>{stage.number}</span>
            <div><h3>{stage.title}</h3><p>{stage.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="capabilities section-shell" data-reveal><div class="capabilities-heading"><p class="section-index">04 / Capabilities</p><h2>From architecture<br />to the <em>last detail.</em></h2></div><div class="capability-list">{expertise.map((category, index) => <details open={index === 0}><summary><span>0{index + 1}</span>{category.name}<i>+</i></summary><div>{category.stack.map((tech) => <span>{tech}</span>)}</div></details>)}</div></section>

    <section id="experience" class="experience section-shell" data-reveal><p class="section-index">05 / Experience</p><div class="experience-layout"><h2>Built across agencies,<br />products and <em>teams.</em></h2><ol>{experience.map((job) => <li><span>{job.period}</span><div><h3>{job.company}</h3><p>{job.role}</p><p class="experience-impact">{job.impact}</p></div></li>)}</ol></div></section>

    <section class="about-section section-shell glass-panel" data-reveal><p class="section-index">06 / About</p><p class="about-lead">Engineering with a product lens.</p><p>{about.paragraph}</p></section>

    <section class="closing section-shell" data-reveal><p class="eyebrow">Available for selected opportunities</p><h2>Have something<br /><em>worth building?</em></h2><p>{closing.body}</p><a class="button button-primary" href="/contact/">Start a conversation <span>↗</span></a></section>
  </main>
  <Footer />
</Layout>
