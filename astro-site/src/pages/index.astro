---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatTile from '../components/StatTile.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { hero, proof, expertise, experience, about, githubRepos, closing, person, mobileIntro, mobileProjects } from '../data/site';

const projects = (await getCollection('work'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Ysidro Almonte — Senior WordPress / PHP Engineer"
  description="Senior WordPress / PHP Engineer with 8+ years building custom plugins, WooCommerce solutions, API integrations, and high-performance websites for remote, international teams."
  path="/"
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="mx-auto max-w-4xl px-6 pb-14 pt-16 sm:pt-24">
      <p class="font-mono text-sm text-ink-500">{hero.eyebrow}</p>
      <h1 class="mt-3 max-w-2xl font-serif text-5xl font-semibold leading-[1.1] text-ink-900">
        {hero.headline}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-700">{hero.subhead}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {hero.chips.map((chip) => (
          <li class="rounded-full border border-ink-300 bg-ink-100 px-3 py-1 font-mono text-xs text-ink-700">{chip}</li>
        ))}
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={hero.ctaPrimary.href} class="rounded-md bg-accent-600 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-ink-50 hover:bg-accent-900">
          {hero.ctaPrimary.label}
        </a>
        <a href={hero.ctaResume.href} target="_blank" rel="noopener" class="rounded-md border border-accent-600 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-accent-900 hover:bg-accent-100">
          {hero.ctaResume.label}
        </a>
        <a href={hero.ctaGithub.href} target="_blank" rel="noopener" class="font-mono text-sm text-ink-700 hover:text-ink-900">
          {hero.ctaGithub.label} ↗
        </a>
      </div>
    </section>

    <!-- Professional Proof -->
    <section class="border-y border-ink-300 bg-ink-100/60">
      <div class="mx-auto max-w-5xl px-6 py-12">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
          {proof.map((stat) => <StatTile value={stat.value} label={stat.label} />)}
        </div>
      </div>
    </section>

    <!-- Core Expertise -->
    <section class="mx-auto max-w-5xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-accent-600">Core Expertise</p>
      <h2 class="mt-2 font-serif text-3xl font-semibold text-ink-900">Where I operate</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {expertise.map((category) => (
          <div class="rounded-lg border border-ink-300 bg-ink-100 p-5">
            <h3 class="font-semibold text-ink-900">{category.name}</h3>
            <ul class="mt-3 space-y-1.5">
              {category.stack.map((tech) => (
                <li class="font-mono text-xs text-ink-700">{tech}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Featured Engineering Projects -->
    <section class="border-t border-ink-300 bg-ink-100/60">
      <div class="mx-auto max-w-5xl px-6 py-16">
        <p class="font-mono text-xs uppercase tracking-wide text-accent-600">Selected Work</p>
        <h2 class="mt-2 font-serif text-3xl font-semibold text-ink-900">Featured Engineering Projects</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {projects.map((p) => (
            <ProjectCard
              slug={p.id}
              name={p.data.name}
              summary={p.data.summary}
              role={p.data.role}
              stack={p.data.stack}
              results={p.data.results}
              githubUrl={p.data.githubUrl}
              liveUrl={p.data.liveUrl}
              basePath="/work/"
            />
          ))}
        </div>
        <a href="/work/" class="mt-8 inline-block font-mono text-sm font-semibold text-accent-600 hover:text-accent-900">
          View all engineering work →
        </a>
      </div>
    </section>

    <!-- Beyond WordPress (deliberately smaller / quieter than the section above) -->
    <section class="mx-auto max-w-5xl px-6 py-14">
      <p class="font-mono text-xs uppercase tracking-wide text-violet-600">{mobileIntro.eyebrow}</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-ink-900">{mobileIntro.headline}</h2>
      <p class="mt-2 max-w-xl text-sm text-ink-700">{mobileIntro.body}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {mobileProjects.map((app) => (
          <a href={app.url} target="_blank" rel="noopener" class="rounded-lg border border-ink-300 bg-ink-100 p-4 hover:border-violet-600">
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-ink-900">{app.name}</h3>
              <span class="rounded bg-violet-100 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-violet-600">
                {app.status}
              </span>
            </div>
            <p class="mt-1 text-xs font-mono uppercase tracking-wide text-ink-500">{app.category}</p>
            <p class="mt-2 text-sm text-ink-700">{app.description}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {app.stack.map((tech) => (
                <li class="rounded bg-teal-100 px-2 py-0.5 font-mono text-xs text-teal-600">{tech}</li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </section>

    <!-- Engineering on GitHub -->
    <section class="border-t border-ink-300 bg-ink-100/60">
      <div class="mx-auto max-w-5xl px-6 py-14">
        <p class="font-mono text-xs uppercase tracking-wide text-accent-600">Engineering on GitHub</p>
        <h2 class="mt-2 font-serif text-2xl font-semibold text-ink-900">Selected repositories</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {githubRepos.map((repo) => (
            <a href={repo.url} target="_blank" rel="noopener" class="rounded-lg border border-ink-300 bg-ink-100 p-4 hover:border-accent-600">
              <h3 class="font-semibold text-ink-900">{repo.name}</h3>
              <p class="mt-1 text-sm text-ink-700">{repo.demonstrates}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {repo.stack.map((tech) => (
                  <li class="rounded bg-teal-100 px-2 py-0.5 font-mono text-xs text-teal-600">{tech}</li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="mx-auto max-w-4xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-accent-600">Experience</p>
      <h2 class="mt-2 font-serif text-3xl font-semibold text-ink-900">Where I've worked</h2>
      <ol class="mt-8 space-y-6 border-l border-ink-300 pl-6">
        {experience.map((job) => (
          <li>
            <p class="font-mono text-xs text-ink-500">{job.period}</p>
            <h3 class="mt-1 font-semibold text-ink-900">{job.company}</h3>
            <p class="text-sm text-ink-500">{job.role}</p>
            <p class="mt-1 text-sm text-ink-700">{job.impact}</p>
          </li>
        ))}
      </ol>
      <a href={person.links.resume} target="_blank" rel="noopener" class="mt-8 inline-block rounded-md border border-accent-600 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-accent-900 hover:bg-accent-100">
        Download Full Resume
      </a>
    </section>

    <!-- About -->
    <section class="border-t border-ink-300 bg-ink-100/60">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <p class="font-mono text-xs uppercase tracking-wide text-accent-600">About</p>
        <h2 class="mt-2 font-serif text-2xl font-semibold text-ink-900">Engineering with a product lens</h2>
        <p class="mt-4 text-ink-700">{about.paragraph}</p>
      </div>
    </section>

    <!-- Contact / Closing -->
    <section class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="font-serif text-3xl font-semibold text-ink-900">{closing.headline}</h2>
      <p class="mt-3 text-ink-700">{closing.body}</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact/" class="rounded-md bg-accent-600 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-ink-50 hover:bg-accent-900">
          Contact Me
        </a>
        <a href={person.links.linkedin} target="_blank" rel="noopener" class="font-mono text-sm text-ink-700 hover:text-ink-900">LinkedIn</a>
        <a href={person.links.github} target="_blank" rel="noopener" class="font-mono text-sm text-ink-700 hover:text-ink-900">GitHub</a>
        <a href={person.links.resume} target="_blank" rel="noopener" class="font-mono text-sm text-ink-700 hover:text-ink-900">Download Resume</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
