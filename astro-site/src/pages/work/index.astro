---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { moreProjects } from '../../data/site';

const caseStudies = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const visuals: Record<string, { accent: string; image?: string; diagram?: string }> = {
  acrylicphotoprint: { accent: 'cyan', image: '/images/work/featured/acrylic-photo-print.png' },
  'real-estate-api-sync': { accent: 'lime', diagram: '/images/work/diagrams/real-estate-api-sync.svg' },
  'woo-payment-gateway': { accent: 'rose', diagram: '/images/work/diagrams/woo-payment-gateway.svg' },
  'marketing-landing-page-system': { accent: 'sky' },
};
---

<Layout
  title="Engineering Work — Ysidro Almonte"
  description="Case studies in WordPress engineering: custom plugins, WooCommerce, API integrations, and performance work."
  path="/work/"
>
  <Header />
  <main>
    <section class="page-hero section-shell" data-reveal>
      <p class="eyebrow">Engineering work</p>
      <h1>Selected systems,<br /><em>not just screens.</em></h1>
      <p class="lead">Every project below is a technical case study — role, architecture, engineering challenges, and measurable results.</p>
    </section>

    <section class="projects section-shell" aria-label="Case studies">
      {caseStudies.map((p) => {
        const visual = visuals[p.id] ?? { accent: 'violet' };
        return (
          <article class={`project project-${visual.accent}`} data-reveal>
            <div class="project-copy">
              <div class="project-kicker"><span>{p.data.stack[0]}</span><span>{p.data.role}</span></div>
              <h3>{p.data.name}</h3>
              <p>{p.data.summary}</p>
              <ul>{p.data.stack.map((tech) => <li>{tech}</li>)}</ul>
              <div class="project-links">
                <a href={`/work/${p.id}/`}>Read case study <span>↗</span></a>
                {p.data.githubUrl && <a href={p.data.githubUrl} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
                {p.data.liveUrl && <a href={p.data.liveUrl} target="_blank" rel="noopener">Live project <span>↗</span></a>}
              </div>
            </div>
            <div class={`project-visual ${visual.image ? 'browser-stage' : visual.diagram ? 'diagram-stage' : 'visual-mark'}`}>
              {visual.image ? (
                <div class="browser-frame">
                  <span class="browser-bar"><i></i><i></i><i></i></span>
                  <img src={visual.image} alt={`${p.data.name} product screenshot`} loading="lazy" />
                </div>
              ) : visual.diagram ? (
                <img src={visual.diagram} alt={`${p.data.name} architecture diagram`} loading="lazy" />
              ) : (
                <>
                  <span>{p.data.stack[0]}</span>
                  <small>No public screenshot — see case study</small>
                </>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <section class="section-shell" style="padding-bottom:150px" data-reveal>
      <p class="section-index">More projects</p>
      <h2 style="margin:20px 0 14px;font-size:clamp(32px,4.5vw,54px);line-height:1;letter-spacing:-.04em;font-weight:500">Additional client work</h2>
      <p class="lead" style="margin-bottom:50px">Production sites without a full engineering write-up — still real, shipped work.</p>

      <div style="display:grid;gap:22px;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
        {moreProjects.map((p) => (
          <div class="row-card">
            <img src={p.image} alt={p.name} loading="lazy" width="900" height="720" />
            <p class="section-index" style="margin:0">{p.category}</p>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <ul>{p.tags.map((tech) => <li>{tech}</li>)}</ul>
            {p.url && <a href={p.url} target="_blank" rel="noopener" class="row-link">Visit site ↗</a>}
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
