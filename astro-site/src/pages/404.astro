---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found — Ysidro Almonte"
  description="This page doesn't exist."
  path="/404/"
>
  <Header />
  <main class="section-shell" style="min-height:70svh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-top:150px">
    <p class="eyebrow">404</p>
    <h1 style="margin:16px 0 0;font-size:clamp(42px,7vw,96px);line-height:.98;letter-spacing:-.05em;font-weight:500">Page not found</h1>
    <p class="lead" style="margin-top:20px">The page you're looking for doesn't exist or has moved.</p>
    <a class="button button-primary" href="/" style="display:inline-flex;margin-top:36px">Back to home <span>↗</span></a>
  </main>
  <Footer />
</Layout>
