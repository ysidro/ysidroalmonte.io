---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { about, education, experience, person } from '../data/site';
---

<Layout
  title="About — Ysidro Almonte"
  description="Senior WordPress / PHP Engineer with a background in Advertising — combining software engineering, e-commerce, and marketing technology."
  path="/about/"
>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-wide text-accent-600">About</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold text-ink-900">Engineering with a product lens</h1>
    <p class="mt-5 text-lg text-ink-700">{about.paragraph}</p>
    <p class="mt-4 text-ink-700">
      My Bachelor's Degree in Advertising isn't a detour — it's why I build websites that are judged on
      conversion and business impact, not just code quality. Eight years across agencies and remote product
      teams taught me to sit at the intersection of engineering, e-commerce, and marketing technology, and to
      treat performance and Core Web Vitals as product requirements, not afterthoughts.
    </p>

    <h2 class="mt-12 font-serif text-2xl font-semibold text-ink-900">Work &amp; Education</h2>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <div>
        <h3 class="font-mono text-xs uppercase tracking-wide text-ink-500">Experience</h3>
        <ol class="mt-4 space-y-5 border-l border-ink-300 pl-5">
          {experience.map((job) => (
            <li>
              <p class="font-mono text-xs text-ink-500">{job.period}</p>
              <p class="font-semibold text-ink-900">{job.company}</p>
              <p class="text-sm text-ink-500">{job.role}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h3 class="font-mono text-xs uppercase tracking-wide text-ink-500">Education &amp; Training</h3>
        <div class="mt-4">
          <p class="font-semibold text-ink-900">{education.degree}</p>
          <p class="text-sm text-ink-500">{education.school} · {education.year}</p>
        </div>
        <ul class="mt-4 space-y-1.5 text-sm text-ink-700">
          {education.training.map((item) => <li>— {item}</li>)}
        </ul>
      </div>
    </div>

    <a href={person.links.resume} target="_blank" rel="noopener" class="mt-10 inline-block rounded-md border border-accent-600 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-accent-900 hover:bg-accent-100">
      Download Full Resume
    </a>
  </main>
  <Footer />
</Layout>
