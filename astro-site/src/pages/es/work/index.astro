---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { moreProjects } from '../../../data/site.es';

const caseStudies = (await getCollection('workEs')).sort((a, b) => a.data.order - b.data.order);

const visuals: Record<string, { accent: string; image?: string; diagram?: string }> = {
  acrylicphotoprint: { accent: 'cyan', image: '/images/work/featured/acrylic-photo-print.png' },
  'real-estate-api-sync': { accent: 'lime', diagram: '/images/work/diagrams/real-estate-api-sync.svg' },
  'woo-payment-gateway': { accent: 'rose', diagram: '/images/work/diagrams/woo-payment-gateway.svg' },
  'marketing-landing-page-system': { accent: 'sky' },
};
---

<Layout
  title="Trabajo de Ingeniería — Ysidro Almonte"
  description="Casos de estudio de ingeniería en WordPress: plugins a medida, WooCommerce, integraciones de API y trabajo de rendimiento."
  path="/es/work/"
  lang="es"
>
  <Header lang="es" />
  <main>
    <section class="page-hero section-shell" data-reveal>
      <p class="eyebrow">Trabajo de ingeniería</p>
      <h1>Sistemas seleccionados,<br /><em>no solo pantallas.</em></h1>
      <p class="lead">Cada proyecto a continuación es un caso de estudio técnico — rol, arquitectura, retos de ingeniería y resultados medibles.</p>
    </section>

    <section class="projects section-shell" aria-label="Casos de estudio">
      {caseStudies.map((p) => {
        const visual = visuals[p.id] ?? { accent: 'violet' };
        return (
          <article class={`project project-${visual.accent}`} data-reveal>
            <div class="project-copy">
              <div class="project-kicker"><span>{p.data.stack[0]}</span><span>{p.data.role}</span></div>
              <h3>{p.data.name}</h3>
              <p>{p.data.summary}</p>
              <ul>{p.data.stack.map((tech) => <li>{tech}</li>)}</ul>
              <div class="project-links">
                <a href={`/es/work/${p.id}/`}>Leer caso de estudio <span>↗</span></a>
                {p.data.githubUrl && <a href={p.data.githubUrl} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
                {p.data.liveUrl && <a href={p.data.liveUrl} target="_blank" rel="noopener">Proyecto en vivo <span>↗</span></a>}
              </div>
            </div>
            <div class={`project-visual ${visual.image ? 'browser-stage' : visual.diagram ? 'diagram-stage' : 'visual-mark'}`}>
              {visual.image ? (
                <div class="browser-frame">
                  <span class="browser-bar"><i></i><i></i><i></i></span>
                  <img src={visual.image} alt={`Captura de producto de ${p.data.name}`} loading="lazy" />
                </div>
              ) : visual.diagram ? (
                <img src={visual.diagram} alt={`Diagrama de arquitectura de ${p.data.name}`} loading="lazy" />
              ) : (
                <>
                  <span>{p.data.stack[0]}</span>
                  <small>Sin captura pública — ver caso de estudio</small>
                </>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <section class="section-shell" style="padding-bottom:150px" data-reveal>
      <p class="section-index">Más proyectos</p>
      <h2 style="margin:20px 0 14px;font-size:clamp(32px,4.5vw,54px);line-height:1;letter-spacing:-.04em;font-weight:500">Otro trabajo con clientes</h2>
      <p class="lead" style="margin-bottom:50px">Sitios en producción sin un caso de estudio técnico completo — trabajo real igualmente.</p>

      <div style="display:grid;gap:22px;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
        {moreProjects.map((p) => (
          <div class="row-card">
            <img src={p.image} alt={p.name} loading="lazy" width="900" height="720" />
            <p class="section-index" style="margin:0">{p.category}</p>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <ul>{p.tags.map((tech) => <li>{tech}</li>)}</ul>
            {p.url && <a href={p.url} target="_blank" rel="noopener" class="row-link">Visitar sitio ↗</a>}
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
