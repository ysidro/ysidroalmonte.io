---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { hero, proof, expertise, experience, about, closing, person } from '../../data/site.es';

// El trabajo WordPress/PHP encabeza el home — es el portafolio de un
// WordPress engineer, así que lo primero que se ve debe demostrar eso.
const projects = [
  { number: '01', name: 'Acrylic Photo Print', type: 'E-commerce · Personalización de producto', description: 'Un storefront de WooCommerce a medida donde los clientes suben, previsualizan y personalizan productos fotográficos a través de un flujo de compra construido a propósito.', url: 'https://acrylicphotoprint.com/', accent: 'cyan', image: '/images/work/featured/acrylic-photo-print.png', caseStudy: '/es/work/acrylicphotoprint/', stack: ['WordPress', 'WooCommerce', 'Timber', 'Svelte', 'AWS'] },
  { number: '02', name: 'Real Estate API Sync', type: 'Backend WordPress · Sincronización de datos', description: 'Integración WordPress a medida que mantiene sincronizados los listados de propiedades desde APIs inmobiliarias externas, reemplazando la entrada manual con Custom Post Types estructurados.', githubUrl: 'https://github.com/ysidro/real-estate-sync/tree/main', accent: 'lime', caseStudy: '/es/work/real-estate-api-sync/', diagram: '/images/work/diagrams/real-estate-api-sync.svg', stack: ['PHP', 'WordPress', 'WP REST API', 'MySQL'] },
  { number: '03', name: 'Woo Payment Gateway', type: 'WooCommerce · Pagos', description: 'Pasarela de pago a medida para WooCommerce construida para el mercado de República Dominicana, con confirmación segura de transacciones servidor a servidor.', githubUrl: 'https://github.com/ysidro/WooCommerce-CardNet-Payment-Gateway-Dominican-Republic-/blob/main/readme.md', accent: 'rose', caseStudy: '/es/work/woo-payment-gateway/', diagram: '/images/work/diagrams/woo-payment-gateway.svg', stack: ['PHP', 'WooCommerce', 'Payment APIs'] },
  { number: '04', name: 'Chevrolet', type: 'Automotriz · Headless CMS', description: 'Una experiencia automotriz de alto tráfico que usa WordPress como fuente de contenido estructurado y Gatsby para entregar páginas rápidas y optimizadas al cliente final.', url: 'https://chevrolet.com.do/', accent: 'gold', image: '/images/work/featured/chevrolet.png', stack: ['Gatsby', 'React', 'WordPress', 'WPGraphQL'] },
  { number: '05', name: 'Seer', type: 'Biotecnología · Plataforma corporativa', description: 'Una implementación de WordPress y ACF a medida que convierte contenido complejo de proteómica en una plataforma de marketing estructurada y mantenible.', url: 'https://seer.bio/', accent: 'blue', image: '/images/work/featured/seer-bio.png', stack: ['WordPress', 'ACF', 'PHP', 'Custom theme'] },
];

// Mobile / productos propios — rango real de ingeniería, pero tratado de
// forma compacta y visualmente más discreta que el trabajo WordPress.
const beyondWordpress = [
  { name: 'M Voy', type: 'Mobile · Flutter', description: 'App de movilidad de dos lados — flujos de pasajero y conductor, mapas, geolocalización.', url: '/es/mobile/', image: '/images/work/mvoy/user-onboarding.png' },
  { name: 'CreaThink Tools', type: 'Browser SaaS · Next.js', description: 'Herramientas de imagen y QR privadas por defecto, procesadas enteramente en el dispositivo.', url: 'https://creathinktools.com/', image: '/images/work/featured/mvoy-landing.png' },
];
---

<Layout title="Ysidro Almonte — Senior WordPress / PHP Engineer" description="Ingeniero senior construyendo plataformas WordPress de alto rendimiento, productos mobile y herramientas digitales." path="/es/" lang="es">
  <Header lang="es" />
  <main>
    <section class="hero-shell section-shell" data-reveal>
      <div class="hero-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow"><span class="status-dot"></span>{hero.eyebrow}</p>
      <h1>Ingeniería WordPress senior que se siente <em>clara, rápida</em> y profundamente humana.</h1>
      <div class="hero-bottom">
        <p>{hero.subhead}</p>
        <div class="hero-actions"><a class="button button-primary" href="#selected-work">Explorar trabajo seleccionado <span>↘</span></a><a class="text-link" href={person.links.resume} target="_blank" rel="noopener">Currículum ↗</a></div>
      </div>
      <div class="hero-meta"><span>WordPress / PHP</span><span>Ingeniería de producto</span><span>República Dominicana</span></div>
    </section>

    <section id="selected-work" class="work-intro section-shell" data-reveal>
      <div><p class="section-index">01 / Ingeniería WordPress</p><h2>Sistemas seleccionados,<br /><em>no solo pantallas.</em></h2></div>
      <p>Plataformas WordPress y WooCommerce en producción, presentadas a través de las decisiones, flujos e ingeniería detrás de ellas.</p>
    </section>

    <section class="projects section-shell" aria-label="Proyectos seleccionados">
      {projects.map((project) => (
        <article class={`project project-${project.accent}`} data-reveal>
          <div class="project-copy">
            <div class="project-kicker"><span>{project.number}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3><p>{project.description}</p>
            <ul>{project.stack.map((tech) => <li>{tech}</li>)}</ul>
            <div class="project-links">
              {project.caseStudy && <a href={project.caseStudy}>Leer caso de estudio <span>↗</span></a>}
              {project.githubUrl && <a href={project.githubUrl} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
              {project.url && <a href={project.url} target="_blank" rel="noopener">Visitar proyecto <span>↗</span></a>}
            </div>
          </div>
          <div class={`project-visual ${project.images ? 'phone-stage' : project.image ? 'browser-stage' : project.diagram ? 'diagram-stage' : 'visual-mark'}`}>
            {project.images ? (
              project.images.map((src, imageIndex) => <img src={src} alt={`Pantalla ${imageIndex + 1} de la app ${project.name}`} loading={project.number === '01' ? 'eager' : 'lazy'} width="946" height="2048" />)
            ) : project.image ? (
              <div class="browser-frame"><span class="browser-bar"><i></i><i></i><i></i></span><img src={project.image} alt={`Sitio web de ${project.name}`} loading="lazy" /></div>
            ) : project.diagram ? (
              <img src={project.diagram} alt={`Diagrama de arquitectura de ${project.name}`} loading="lazy" />
            ) : (
              <>
                <span>{project.stack[0]}</span>
                <small>Sin captura pública — ver caso de estudio</small>
              </>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="section-shell" style="padding:80px 0 120px" data-reveal>
      <p class="section-index">Más allá de WordPress</p>
      <h2 style="margin:18px 0 12px;font-size:clamp(28px,4vw,44px);line-height:1.05;letter-spacing:-.03em;font-weight:500">Mobile y productos propios</h2>
      <p class="lead" style="margin-bottom:40px;max-width:560px">Rango de ingeniería fuera del núcleo de CMS — tratado brevemente aquí a propósito. <a href="/es/mobile/" style="color:#d9d3ff;border-bottom:1px solid rgba(217,211,255,.4)">Ver todo el trabajo mobile ↗</a></p>
      <div style="display:grid;gap:20px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))">
        {beyondWordpress.map((item) => (
          <a href={item.url} target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener' : undefined} class="row-card" style="display:block">
            <img src={item.image} alt={item.name} loading="lazy" width="900" height="600" style="height:130px" />
            <p class="section-index" style="margin:0">{item.type}</p>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="proof-section section-shell" data-reveal><p class="section-index">02 / Trayectoria</p><div class="proof-grid">{proof.slice(0, 4).map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section>

    <section class="capabilities section-shell" data-reveal><div class="capabilities-heading"><p class="section-index">03 / Capacidades</p><h2>De la arquitectura<br />al <em>último detalle.</em></h2></div><div class="capability-list">{expertise.map((category, index) => <details open={index === 0}><summary><span>0{index + 1}</span>{category.name}<i>+</i></summary><div>{category.stack.map((tech) => <span>{tech}</span>)}</div></details>)}</div></section>

    <section id="experience" class="experience section-shell" data-reveal><p class="section-index">04 / Experiencia</p><div class="experience-layout"><h2>Construido entre agencias,<br />productos y <em>equipos.</em></h2><ol>{experience.map((job) => <li><span>{job.period}</span><div><h3>{job.company}</h3><p>{job.role}</p></div></li>)}</ol></div></section>

    <section class="about-section section-shell glass-panel" data-reveal><p class="section-index">05 / Sobre mí</p><p class="about-lead">Ingeniería con visión de producto.</p><p>{about.paragraph}</p></section>

    <section class="closing section-shell" data-reveal><p class="eyebrow">Disponible para oportunidades seleccionadas</p><h2>¿Tienes algo<br /><em>que valga la pena construir?</em></h2><p>{closing.body}</p><a class="button button-primary" href="/es/contact/">Iniciar una conversación <span>↗</span></a></section>
  </main>
  <Footer />
</Layout>
