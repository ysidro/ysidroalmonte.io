---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { hero, proof, expertise, experience, about, closing, person } from '../../data/site.es';

const projects = [
  { number: '01', name: 'M Voy', type: 'Producto mobile · Flutter', description: 'Una experiencia de movilidad de dos lados con flujos dedicados para pasajero y conductor — desde solicitar un viaje hasta recibir y aceptar ofertas de conductores.', url: 'https://mvoyrd.com/', accent: 'yellow', images: ['/images/work/mvoy/user-onboarding.png', '/images/work/mvoy/user-map.png', '/images/work/mvoy/user-offer.png'], stack: ['Flutter', 'Dart', 'REST APIs', 'Maps', 'Geolocation'] },
  { number: '02', name: 'CreaThink Tools', type: 'Producto independiente · Browser SaaS', description: 'Una suite privada por defecto para tareas cotidianas de imagen y QR. El producto, la interfaz, el procesamiento en el dispositivo y el acceso de pago se construyeron como un sistema coherente.', url: 'https://creathinktools.com/', accent: 'violet', image: '/images/work/featured/mvoy-landing.png', stack: ['Cloudflare Workers', 'D1', 'Paddle', 'Client-side processing'] },
  { number: '03', name: 'Acrylic Photo Print', type: 'E-commerce · Personalización de producto', description: 'Un storefront de WooCommerce a medida donde los clientes suben, previsualizan y personalizan productos fotográficos a través de un flujo de compra construido a propósito.', url: 'https://acrylicphotoprint.com/', accent: 'cyan', image: '/images/work/featured/acrylic-photo-print.png', caseStudy: '/es/work/acrylicphotoprint/', stack: ['WordPress', 'WooCommerce', 'Timber', 'Svelte', 'AWS'] },
  { number: '04', name: 'Chevrolet', type: 'Automotriz · Headless CMS', description: 'Una experiencia automotriz de alto tráfico que usa WordPress como fuente de contenido estructurado y Gatsby para entregar páginas rápidas y optimizadas al cliente final.', url: 'https://chevrolet.com.do/', accent: 'gold', image: '/images/work/featured/chevrolet.png', stack: ['Gatsby', 'React', 'WordPress', 'WPGraphQL'] },
  { number: '05', name: 'Seer', type: 'Biotecnología · Plataforma corporativa', description: 'Una implementación de WordPress y ACF a medida que convierte contenido complejo de proteómica en una plataforma de marketing estructurada y mantenible.', url: 'https://seer.bio/', accent: 'blue', image: '/images/work/featured/seer-bio.png', stack: ['WordPress', 'ACF', 'PHP', 'Custom theme'] },
];
---

<Layout title="Ysidro Almonte — Senior WordPress / PHP Engineer" description="Ingeniero senior construyendo plataformas WordPress de alto rendimiento, productos mobile y herramientas digitales." path="/es/" lang="es">
  <Header lang="es" />
  <main>
    <section class="hero-shell section-shell" data-reveal>
      <div class="hero-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow"><span class="status-dot"></span>{hero.eyebrow}</p>
      <h1>Diseño productos digitales que se sienten <em>claros, rápidos</em> y profundamente humanos.</h1>
      <div class="hero-bottom">
        <p>{hero.subhead}</p>
        <div class="hero-actions"><a class="button button-primary" href="#selected-work">Explorar trabajo seleccionado <span>↘</span></a><a class="text-link" href={person.links.resume} target="_blank" rel="noopener">Currículum ↗</a></div>
      </div>
      <div class="hero-meta"><span>WordPress / PHP</span><span>Ingeniería de producto</span><span>República Dominicana</span></div>
    </section>

    <section id="selected-work" class="work-intro section-shell" data-reveal>
      <div><p class="section-index">01 / Trabajo seleccionado</p><h2>Sistemas seleccionados,<br /><em>no solo pantallas.</em></h2></div>
      <p>Plataformas de clientes y productos propios presentados a través de las decisiones, flujos e ingeniería detrás de ellos.</p>
    </section>

    <section class="projects section-shell" aria-label="Proyectos seleccionados">
      {projects.map((project) => (
        <article class={`project project-${project.accent}`} data-reveal>
          <div class="project-copy">
            <div class="project-kicker"><span>{project.number}</span><span>{project.type}</span></div>
            <h3>{project.name}</h3><p>{project.description}</p>
            <ul>{project.stack.map((tech) => <li>{tech}</li>)}</ul>
            <div class="project-links">{project.caseStudy && <a href={project.caseStudy}>Leer caso de estudio <span>↗</span></a>}<a href={project.url} target="_blank" rel="noopener">Visitar proyecto <span>↗</span></a></div>
          </div>
          <div class={`project-visual ${project.images ? 'phone-stage' : 'browser-stage'}`}>
            {project.images ? project.images.map((src, imageIndex) => <img src={src} alt={`Pantalla ${imageIndex + 1} de la app ${project.name}`} loading={project.number === '01' ? 'eager' : 'lazy'} width="946" height="2048" />) : <div class="browser-frame"><span class="browser-bar"><i></i><i></i><i></i></span><img src={project.image} alt={`Sitio web de ${project.name}`} loading="lazy" /></div>}
          </div>
        </article>
      ))}
    </section>

    <section class="proof-section section-shell" data-reveal><p class="section-index">02 / Trayectoria</p><div class="proof-grid">{proof.slice(0, 4).map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div></section>

    <section class="capabilities section-shell" data-reveal><div class="capabilities-heading"><p class="section-index">03 / Capacidades</p><h2>De la arquitectura<br />al <em>último detalle.</em></h2></div><div class="capability-list">{expertise.map((category, index) => <details open={index === 0}><summary><span>0{index + 1}</span>{category.name}<i>+</i></summary><div>{category.stack.map((tech) => <span>{tech}</span>)}</div></details>)}</div></section>

    <section id="experience" class="experience section-shell" data-reveal><p class="section-index">04 / Experiencia</p><div class="experience-layout"><h2>Construido entre agencias,<br />productos y <em>equipos.</em></h2><ol>{experience.map((job) => <li><span>{job.period}</span><div><h3>{job.company}</h3><p>{job.role}</p></div></li>)}</ol></div></section>

    <section class="about-section section-shell glass-panel" data-reveal><p class="section-index">05 / Sobre mí</p><p class="about-lead">Ingeniería con visión de producto.</p><p>{about.paragraph}</p></section>

    <section class="closing section-shell" data-reveal><p class="eyebrow">Disponible para oportunidades seleccionadas</p><h2>¿Tienes algo<br /><em>que valga la pena construir?</em></h2><p>{closing.body}</p><a class="button button-primary" href="/es/contact/">Iniciar una conversación <span>↗</span></a></section>
  </main>
  <Footer />
</Layout>
