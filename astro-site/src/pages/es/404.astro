---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Página no encontrada — Ysidro Almonte"
  description="Esta página no existe."
  path="/es/404/"
  lang="es"
>
  <Header lang="es" />
  <main class="section-shell" style="min-height:70svh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-top:150px">
    <p class="eyebrow">404</p>
    <h1 style="margin:16px 0 0;font-size:clamp(42px,7vw,96px);line-height:.98;letter-spacing:-.05em;font-weight:500">Página no encontrada</h1>
    <p class="lead" style="margin-top:20px">La página que buscas no existe o fue movida.</p>
    <a class="button button-primary" href="/es/" style="display:inline-flex;margin-top:36px">Volver al inicio <span>↗</span></a>
  </main>
  <Footer />
</Layout>
