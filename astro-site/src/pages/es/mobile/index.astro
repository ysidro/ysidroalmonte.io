---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { mobileIntro, mobileProjects } from '../../../data/site.es';

const screens: Record<string, string[]> = {
  'M Voy': [
    '/images/work/mvoy/user-map.png',
    '/images/work/mvoy/user-offer.png',
    '/images/work/mvoy/user-request.png',
  ],
  Octanos: [
    '/images/work/octanos/login.png',
    '/images/work/octanos/address-map.png',
    '/images/work/octanos/fuel-order.png',
  ],
};
---

<Layout
  title={`${mobileIntro.headline} — Ysidro Almonte`}
  description="Ingeniería mobile y de APIs con Flutter, Dart y Go — más allá del núcleo WordPress/PHP."
  path="/es/mobile/"
  lang="es"
>
  <Header lang="es" />
  <main>
    <section class="page-hero section-shell" data-reveal>
      <p class="eyebrow">{mobileIntro.eyebrow}</p>
      <h1>{mobileIntro.headline}</h1>
      <p class="lead">{mobileIntro.body}</p>
    </section>

    <section class="projects section-shell" aria-label="Productos mobile">
      {mobileProjects.map((app) => {
        const images = screens[app.name];
        return (
          <article class="project project-violet" data-reveal>
            <div class="project-copy">
              <div class="project-kicker"><span>{app.status}</span><span>{app.category}</span></div>
              <h3>{app.name}</h3>
              <p>{app.description}</p>
              <ul>{app.stack.map((tech) => <li>{tech}</li>)}</ul>
              <div class="project-links">
                <a href={app.url} target="_blank" rel="noopener">Visitar sitio <span>↗</span></a>
              </div>
            </div>
            <div class={`project-visual ${images ? 'phone-stage' : 'visual-mark'}`}>
              {images ? (
                images.map((src, i) => <img src={src} alt={`Pantalla ${i + 1} de la app ${app.name}`} loading="lazy" width="946" height="2048" />)
              ) : (
                <>
                  <span>{app.stack[0]}</span>
                  <small>En desarrollo activo</small>
                </>
              )}
            </div>
          </article>
        );
      })}
    </section>
  </main>
  <Footer />
</Layout>
