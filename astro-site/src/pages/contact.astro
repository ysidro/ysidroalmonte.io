---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, closing } from '../data/site';
---

<Layout
  title="Contact — Ysidro Almonte"
  description="Get in touch with Ysidro Almonte, Senior WordPress / PHP Engineer available for remote opportunities."
  path="/contact/"
>
  <Header />
  <main class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="font-serif text-4xl font-semibold text-ink-900">{closing.headline}</h1>
    <p class="mt-3 text-lg text-ink-700">{closing.body}</p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href={`mailto:${person.email}`} class="rounded-md bg-accent-600 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-ink-50 hover:bg-accent-900">
        Contact Me
      </a>
      <a href={person.links.linkedin} target="_blank" rel="noopener" class="rounded-md border border-ink-300 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-ink-700 hover:border-ink-900 hover:text-ink-900">
        LinkedIn
      </a>
      <a href={person.links.github} target="_blank" rel="noopener" class="rounded-md border border-ink-300 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-ink-700 hover:border-ink-900 hover:text-ink-900">
        GitHub
      </a>
      <a href={person.links.resume} target="_blank" rel="noopener" class="rounded-md border border-ink-300 px-5 py-2.5 font-mono text-sm font-semibold uppercase tracking-wide text-ink-700 hover:border-ink-900 hover:text-ink-900">
        Download Resume
      </a>
    </div>

    <p class="mt-10 font-mono text-sm text-ink-500">{person.email}</p>
  </main>
  <Footer />
</Layout>
