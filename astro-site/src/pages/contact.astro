---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, closing } from '../data/site';
---

<Layout
  title="Contact — Ysidro Almonte"
  description="Get in touch with Ysidro Almonte, Senior WordPress / PHP Engineer available for remote opportunities."
  path="/contact/"
>
  <Header />
  <main class="contact-page section-shell">
    <section class="contact-grid" data-reveal>
      <div class="contact-intro">
        <p class="eyebrow">Available for selected opportunities</p>
        <h1>{closing.headline}</h1>
        <p>{closing.body}</p>
        <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${person.email}`}>Contact me <span>↗</span></a>
        <a class="text-link" href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="text-link" href={person.links.github} target="_blank" rel="noopener">GitHub</a>
        <a class="text-link" href={person.links.resume} target="_blank" rel="noopener">Résumé</a>
        </div>
        <p class="contact-email">{person.email}</p>
      </div>
      <aside class="contact-brief">
        <h2>Help me understand the work.</h2>
        <p>A useful first message does not need to be long. Include the context that affects scope and fit.</p>
        <ul>
          <li><span>01</span>Project or platform you need help with</li>
          <li><span>02</span>Current stack and production environment</li>
          <li><span>03</span>Immediate problem or desired outcome</li>
          <li><span>04</span>Expected timeline and engagement type</li>
        </ul>
        <p class="contact-availability">Best fit: ongoing agency support, long-term contracts, custom WordPress/WooCommerce development, integrations, and production troubleshooting.</p>
      </aside>
    </section>
  </main>
  <Footer />
</Layout>
