---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyList from '../components/StickyList.astro';
import StickyProjects from '../components/StickyProjects.astro';
import { moreProjects as moreEn } from '../data/site';
import { moreProjects as moreEs } from '../data/site.es';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const p = lang === 'es' ? '/es' : '';
const caseStudies = (await getCollection(lang === 'es' ? 'workEs' : 'work')).sort((a, b) => a.data.order - b.data.order);
const more = lang === 'es' ? moreEs : moreEn;

const t = lang === 'es'
  ? {
      title: 'Trabajo de Ingeniería — Ysidro Almonte',
      description: 'Casos de estudio de ingeniería en WordPress: plugins a medida, WooCommerce, integraciones de API y trabajo de rendimiento.',
      h1: 'Sistemas seleccionados, no solo pantallas.',
      lede: 'Cada proyecto a continuación es un caso de estudio técnico: rol, arquitectura, retos de ingeniería y resultados medibles.',
      read: 'Leer caso de estudio',
      live: 'Proyecto en vivo',
      moreTitle: 'Trabajo con clientes',
      moreLead: 'Sitios en producción entregados a clientes reales, de plataformas headless a tiendas WooCommerce.',
      visitSite: 'Visitar sitio',
    }
  : {
      title: 'Engineering Work — Ysidro Almonte',
      description: 'Case studies in WordPress engineering: custom plugins, WooCommerce, API integrations, and performance work.',
      h1: 'Selected systems, not just screens.',
      lede: 'Every project below is a technical case study: role, architecture, engineering challenges, and measurable results.',
      read: 'Read case study',
      live: 'Live project',
      moreTitle: 'Client work',
      moreLead: 'Production sites shipped for real clients, from headless platforms to WooCommerce storefronts.',
      visitSite: 'Visit site',
    };
---

<Layout title={t.title} description={t.description} path={`${p}/work/`} lang={lang}>
  <Header lang={lang} />
  <main>

    <section class="wrap section" aria-label={t.h1}>
      <StickyList label={t.h1} level={1} title={t.h1} lead={t.lede} items={caseStudies.map((c) => ({
        title: c.data.name, kicker: c.data.role, body: c.data.summary, tags: c.data.stack,
        links: [
          { href: `${p}/work/${c.id}/`, label: t.read },
          ...(c.data.githubUrl ? [{ href: c.data.githubUrl, label: 'GitHub', external: true }] : []),
          ...(c.data.liveUrl ? [{ href: c.data.liveUrl, label: t.live, external: true }] : []),
        ],
      }))} />
    </section>

    <section class="wrap section">
      <StickyProjects title={t.moreTitle} lead={t.moreLead} items={more.map((m) => ({ name: m.name, category: m.category, description: m.description, tags: m.tags, url: m.url, image: m.image, fullpage: (m as { fullpage?: string }).fullpage }))} visit={t.visitSite} lang={lang} />
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
