---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import * as en from '../data/site';
import * as es from '../data/site.es';
import { homeProjects, beyondProjects } from '../data/projects';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const d = lang === 'es' ? es : en;
const p = lang === 'es' ? '/es' : '';
const projects = homeProjects[lang];
const beyond = beyondProjects[lang];
const [featured, ...rest] = projects;

const t = lang === 'es'
  ? {
      title: 'Ysidro Almonte — Senior WordPress / PHP Engineer',
      description: 'Ingeniero senior de WordPress y PHP que desarrolla plugins, sistemas WooCommerce, integraciones de API y productos digitales asistidos por IA para agencias y equipos remotos.',
      h1: 'Ingeniería WordPress senior, acelerada por IA y guiada por criterio técnico.',
      explore: 'Explorar trabajo seleccionado',
      resume: 'Currículum',
      facts: [
        ['Rol', 'Senior WordPress / PHP Engineer'],
        ['Experiencia', '8+ años'],
        ['Enfoque', 'Plugins a medida, WooCommerce, APIs'],
        ['Ubicación', 'República Dominicana'],
        ['Disponibilidad', 'Remoto, equipos de EE. UU. e internacionales'],
      ],
      workTitle: 'Trabajo WordPress seleccionado',
      workLead: 'Plataformas WordPress y WooCommerce en producción, presentadas a través de las decisiones, flujos e ingeniería detrás de ellas.',
      readCase: 'Leer caso de estudio',
      visit: 'Visitar proyecto',
      beyondTitle: 'Más allá de WordPress',
      beyondLead: 'Rango de ingeniería fuera del núcleo de CMS, tratado brevemente aquí a propósito.',
      beyondAll: 'Ver todo el trabajo mobile',
      capTitle: 'Capacidades',
      expTitle: 'Experiencia',
      aboutTitle: 'Ingeniería con visión de producto.',
      closeTitle: '¿Tienes algo que valga la pena construir?',
      closeCta: 'Iniciar una conversación',
      shotAlt: 'Sitio web de',
    }
  : {
      title: 'Ysidro Almonte — Senior WordPress / PHP Engineer',
      description: 'Senior WordPress and PHP engineer building custom plugins, WooCommerce systems, API integrations, and AI-assisted digital products for agencies and remote teams.',
      h1: 'Senior WordPress engineering, accelerated by AI and grounded in judgment.',
      explore: 'Explore selected work',
      resume: 'Résumé',
      facts: [
        ['Role', 'Senior WordPress / PHP Engineer'],
        ['Experience', '8+ years'],
        ['Focus', 'Custom plugins, WooCommerce, APIs'],
        ['Location', 'Dominican Republic'],
        ['Availability', 'Remote, U.S. and international teams'],
      ],
      workTitle: 'Selected WordPress work',
      workLead: 'Production WordPress and WooCommerce platforms, presented through the decisions, flows and engineering behind them.',
      readCase: 'Read case study',
      visit: 'Visit project',
      beyondTitle: 'Beyond WordPress',
      beyondLead: 'Engineering range outside the CMS core, kept intentionally brief here.',
      beyondAll: 'See the full mobile work',
      capTitle: 'Capabilities',
      expTitle: 'Experience',
      aboutTitle: 'Engineering with a product lens.',
      closeTitle: 'Have something worth building?',
      closeCta: 'Start a conversation',
      shotAlt: 'Website of',
    };
---

<Layout title={t.title} description={t.description} path={`${p}/`} lang={lang}>
  <Header lang={lang} />
  <main>
    <section class="wrap hero">
      <div>
        <h1>{t.h1}</h1>
        <p class="lede">{d.hero.subhead}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#work">{t.explore}</a>
          <a class="link" href={d.person.links.resume} target="_blank" rel="noopener">{t.resume}</a>
        </div>
      </div>
      <ul class="facts">
        {t.facts.map(([k, v]) => <li><span>{k}</span><span>{v}</span></li>)}
      </ul>
    </section>

    <div class="wrap proof">
      {d.proof.slice(0, 4).map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
    </div>

    <section class="wrap section" id="work">
      <div class="section-head">
        <h2>{t.workTitle}</h2>
        <p>{t.workLead}</p>
      </div>

      <article class="feature">
        <div>
          <p class="label">01</p>
          <h3>{featured.name}</h3>
          <p>{featured.description}</p>
          <ul class="tokens">{featured.stack.map((s) => <li>{s}</li>)}</ul>
          <div class="row-links">
            {featured.caseStudy && <a class="link" href={featured.caseStudy}>{t.readCase}</a>}
            {featured.url && <a class="link" href={featured.url} target="_blank" rel="noopener">{t.visit}</a>}
          </div>
        </div>
        {featured.image && (
          <figure class="shot"><img src={featured.image} alt={`${t.shotAlt} ${featured.name}`} width="1440" height="900" loading="lazy" /></figure>
        )}
      </article>

      <ol class="index">
        {rest.map((project, i) => (
          <li class="index-row">
            <span class="no">{String(i + 2).padStart(2, '0')}</span>
            <div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
            <ul class="tokens">{project.stack.map((s) => <li>{s}</li>)}</ul>
            <div class="row-links">
              {project.caseStudy && <a class="link" href={project.caseStudy}>{t.readCase}</a>}
              {project.githubUrl && <a class="link" href={project.githubUrl} target="_blank" rel="noopener">GitHub</a>}
              {project.url && <a class="link" href={project.url} target="_blank" rel="noopener">{t.visit}</a>}
            </div>
          </li>
        ))}
      </ol>

      <h3 class="subhead">{t.beyondTitle}</h3>
      <p class="muted">{t.beyondLead} <a class="link" href={`${p}/mobile/`}>{t.beyondAll}</a></p>
      <ol class="index plain">
        {beyond.map((project) => (
          <li class="index-row">
            <div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
            </div>
            <ul class="tokens">{project.stack.map((s) => <li>{s}</li>)}</ul>
            <div class="row-links">
              <a class="link" href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noopener' : undefined}>{t.visit}</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap section" id="ai-workflow">
      <div class="split">
        <div>
          <h2>{d.aiWorkflow.headline}</h2>
          <p class="body">{d.aiWorkflow.body}</p>
          <p class="note">{d.aiWorkflow.note}</p>
        </div>
        <ol class="steps">
          {d.aiWorkflow.stages.map((stage) => (
            <li>
              <span class="step-no">{stage.number}</span>
              <div><h3>{stage.title}</h3><p>{stage.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="wrap section" id="capabilities">
      <div class="section-head"><h2>{t.capTitle}</h2></div>
      <div class="spec">
        {d.expertise.map((category) => (
          <div>
            <h3>{category.name}</h3>
            <ul class="tokens">{category.stack.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="wrap section" id="experience">
      <div class="section-head"><h2>{t.expTitle}</h2></div>
      <ol class="timeline">
        {d.experience.map((job) => (
          <li>
            <span class="period">{job.period}</span>
            <div>
              <h3>{job.company}</h3>
              <p class="role">{job.role}</p>
              <p class="impact">{job.impact}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap section" id="about">
      <div class="split">
        <h2>{t.aboutTitle}</h2>
        <p class="prose">{d.about.paragraph}</p>
      </div>
    </section>

    <section class="wrap section">
      <div class="cta-band">
        <div>
          <h2>{t.closeTitle}</h2>
          <p>{d.closing.body}</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={`${p}/contact/`}>{t.closeCta}</a>
          <a class="link" href={d.person.links.resume} target="_blank" rel="noopener">{t.resume}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
