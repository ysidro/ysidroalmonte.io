---
import '../styles/global.css';
import { person } from '../data/site';
import displayFont from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  lang?: 'en' | 'es';
  noindex?: boolean;
}

const { title, description, path = '/', lang = 'en', noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://ysidroalmonte.com');
const canonical = new URL(path, site).toString();

// path is always the English path (e.g. "/work/"); the Spanish equivalent
// just lives under /es, so alternates are derived from it rather than passed twice.
const enPath = path.replace(/^\/es\/?/, '/');
const esPath = '/es' + (enPath === '/' ? '/' : enPath);
const enHref = new URL(enPath, site).toString();
const esHref = new URL(esPath, site).toString();
const ogImage = new URL('/og-image.jpg', site).toString();
const isHome = enPath === '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="es" href={esHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.title}`} />
    <meta property="og:locale" content={lang === 'es' ? 'es_DO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.jpg" type="image/jpeg" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.jpg" type="image/jpeg" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f8f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1416" media="(prefers-color-scheme: dark)" />

    {isHome && !noindex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: person.fullName,
        jobTitle: person.title,
        url: person.links.site,
        image: ogImage,
        sameAs: [person.links.linkedin, person.links.github],
      })} />
    )}

    <!-- Prefetch (not prerender, so analytics only fires on a real visit) likely next pages on hover. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[target=_blank], [rel~=nofollow]' } }] }, eagerness: 'moderate' }],
    })} />

    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-B52YZ2XD3T"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-B52YZ2XD3T');
</script>

  </head>
  <body>
    <slot />
    <script>
      const targets = document.querySelectorAll('main .section, main .prose-case, main .results, main .figure');
      const reveal = (el: Element) => el.classList.add('is-visible');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targets.forEach(reveal);
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } });
        }, { threshold: 0.06, rootMargin: '0px 0px -6% 0px' });
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
