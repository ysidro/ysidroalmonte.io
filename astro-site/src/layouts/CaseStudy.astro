---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Diagram from '../components/Diagram.astro';

interface Props {
  name: string;
  summary: string;
  role: string;
  stack: string[];
  results: string[];
  githubUrl?: string;
  liveUrl?: string;
  heroImage?: string;
  slug?: string;
  lang?: 'en' | 'es';
}

const { name, summary, role, stack, results, githubUrl, liveUrl, heroImage, slug, lang = 'en' } = Astro.props;
const p = lang === 'es' ? '/es' : '';
const diagramName = slug === 'real-estate-api-sync' || slug === 'woo-payment-gateway' ? slug : undefined;
const photo = heroImage && !heroImage.endsWith('.svg') ? heroImage : undefined;

const t = lang === 'es'
  ? { role: 'Rol', stack: 'Stack', links: 'Enlaces', github: 'GitHub', live: 'Proyecto en vivo', private: 'Trabajo privado para cliente, código no disponible públicamente', results: 'Resultados', closing: '¿Buscas un Senior WordPress / PHP Engineer?', closingBody: 'Estoy disponible para oportunidades remotas con equipos internacionales.', contact: 'Contáctame', back: 'Todos los proyectos' }
  : { role: 'Role', stack: 'Stack', links: 'Links', github: 'GitHub', live: 'Live project', private: 'Private client work, code not publicly available', results: 'Results', closing: 'Looking for a Senior WordPress / PHP Engineer?', closingBody: 'I’m available for remote opportunities with international teams.', contact: 'Contact me', back: 'All projects' };
---

<Layout title={`${name} — Ysidro Almonte`} description={summary} path={Astro.url.pathname} lang={lang}>
  <Header lang={lang} />
  <main class="wrap">
    <header class="case-head">
      <a class="link muted" href={`${p}/work/`}>← {t.back}</a>
      <h1 style="margin-top: var(--space-md)">{name}</h1>
      <p class="lede">{summary}</p>
      <dl class="meta">
        <div><dt>{t.role}</dt><dd>{role}</dd></div>
        <div><dt>{t.stack}</dt><dd><ul class="tokens">{stack.map((s) => <li>{s}</li>)}</ul></dd></div>
        <div>
          <dt>{t.links}</dt>
          <dd>
            <span class="row-links">
              {githubUrl && <a class="link" href={githubUrl} target="_blank" rel="noopener">{t.github}</a>}
              {liveUrl && <a class="link" href={liveUrl} target="_blank" rel="noopener">{t.live}</a>}
              {!githubUrl && !liveUrl && <span class="muted">{t.private}</span>}
            </span>
            {!githubUrl && liveUrl && <span class="muted" style="display:block; margin-top: var(--space-3xs)">{t.private}</span>}
          </dd>
        </div>
      </dl>
    </header>

    {diagramName && <Diagram name={diagramName} />}
    {!diagramName && photo && (
      <figure class="figure"><img src={photo} alt={`${name}`} width="1440" height="900" loading="eager" /></figure>
    )}

    <article class="prose-case">
      <slot />
    </article>

    {results.length > 0 && (
      <aside class="results">
        <h2>{t.results}</h2>
        <ul>{results.map((r) => <li>{r}</li>)}</ul>
      </aside>
    )}

    <section class="section" style="border-top: var(--rule-hair) solid var(--color-rule)">
      <div class="cta-band">
        <div><h2>{t.closing}</h2><p>{t.closingBody}</p></div>
        <div class="actions"><a class="btn btn-primary" href={`${p}/contact/`}>{t.contact}</a></div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
