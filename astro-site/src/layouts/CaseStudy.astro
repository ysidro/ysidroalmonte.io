---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  name: string;
  summary: string;
  role: string;
  stack: string[];
  results: string[];
  githubUrl?: string;
  liveUrl?: string;
  heroImage?: string;
  lang?: 'en' | 'es';
}

const { name, summary, role, stack, results, githubUrl, liveUrl, heroImage, lang = 'en' } = Astro.props;

const t = lang === 'es'
  ? {
      caseStudy: 'Caso de estudio',
      github: 'GitHub',
      live: 'Proyecto en vivo',
      private: 'Trabajo privado para cliente — código no disponible públicamente',
      results: 'Resultados',
      closingHeadline: '¿Buscas un Senior WordPress / PHP Engineer?',
      closingBody: 'Estoy disponible para oportunidades remotas con equipos internacionales.',
      contact: 'Contáctame',
    }
  : {
      caseStudy: 'Case study',
      github: 'GitHub',
      live: 'Live project',
      private: 'Private client work — code not publicly available',
      results: 'Results',
      closingHeadline: "Looking for a Senior WordPress / PHP Engineer?",
      closingBody: "I'm available for remote opportunities with international teams.",
      contact: 'Contact me',
    };
---

<Layout title={`${name} — Ysidro Almonte`} description={summary} path={Astro.url.pathname} lang={lang}>
  <Header lang={lang} />
  <main class="section-shell">
    <section class="case-hero" data-reveal>
      <p class="eyebrow">{t.caseStudy}</p>
      <h1>{name}</h1>
      <p class="lead">{summary}</p>
      <ul>{stack.map((tech) => <li>{tech}</li>)}</ul>

      <div class="case-meta">
        <span>{role}</span>
        {githubUrl && <a href={githubUrl} target="_blank" rel="noopener">{t.github} ↗</a>}
        {liveUrl && <a href={liveUrl} target="_blank" rel="noopener">{t.live} ↗</a>}
        {!githubUrl && <span>{t.private}</span>}
      </div>
    </section>

    {heroImage && (
      <figure class="case-figure" data-reveal>
        <img src={heroImage} alt={`${name} product screenshot`} loading="eager" />
      </figure>
    )}

    <article class="prose-case" data-reveal>
      <slot />
    </article>

    {results.length > 0 && (
      <div class="glass" style="margin:0 0 60px;border-radius:24px;padding:36px;max-width:720px" data-reveal>
        <p class="section-index" style="margin:0 0 14px">{t.results}</p>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;color:#c0c1c6;font-size:14px">
          {results.map((r) => <li>— {r}</li>)}
        </ul>
      </div>
    )}

    <div class="glass glass-accent" style="margin:0 0 150px;border-radius:24px;padding:50px;text-align:center;max-width:720px" data-reveal>
      <p style="margin:0;font:400 26px/1.3 Georgia,serif;color:#ddd7ff">{t.closingHeadline}</p>
      <p style="margin:14px 0 0;color:#a2a4ab">{t.closingBody}</p>
      <a class="button button-primary" href={lang === 'es' ? '/es/contact/' : '/contact/'} style="display:inline-flex;margin-top:28px">{t.contact} <span>↗</span></a>
    </div>
  </main>
  <Footer />
</Layout>
