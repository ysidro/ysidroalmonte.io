---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  name: string;
  summary: string;
  role: string;
  stack: string[];
  results: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const { name, summary, role, stack, results, githubUrl, liveUrl } = Astro.props;
---

<Layout title={`${name} — Ysidro Almonte`} description={summary} path={Astro.url.pathname}>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-14">
    <p class="font-mono text-xs uppercase tracking-wide text-accent-600">Case Study</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold text-ink-900">{name}</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-700">{summary}</p>
    <p class="mt-2 font-mono text-sm text-ink-500">{role}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {stack.map((tech) => (
        <li class="rounded bg-teal-100 px-2 py-0.5 font-mono text-xs text-teal-600">{tech}</li>
      ))}
    </ul>

    <div class="mt-4 flex gap-4 text-sm">
      {githubUrl && <a href={githubUrl} target="_blank" rel="noopener" class="text-ink-700 hover:text-ink-900">GitHub ↗</a>}
      {liveUrl && <a href={liveUrl} target="_blank" rel="noopener" class="text-ink-700 hover:text-ink-900">Live Project ↗</a>}
    </div>

    <article class="prose-case mt-10 border-t border-ink-300 pt-8">
      <slot />
    </article>

    {results.length > 0 && (
      <div class="mt-10 rounded-lg border border-ink-300 bg-ink-100 p-6">
        <p class="font-mono text-xs uppercase tracking-wide text-accent-600">Results</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-700">
          {results.map((r) => <li>— {r}</li>)}
        </ul>
      </div>
    )}

    <div class="mt-14 rounded-lg border border-accent-600 bg-accent-100 p-6 text-center">
      <p class="font-serif text-xl font-semibold text-accent-900">Looking for a Senior WordPress / PHP Engineer?</p>
      <p class="mt-1 text-sm text-accent-900">I'm available for remote opportunities with international teams.</p>
      <a href="/contact/" class="mt-4 inline-block rounded-md bg-accent-600 px-5 py-2 font-mono text-xs font-semibold uppercase tracking-wide text-ink-50">Contact Me</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .prose-case :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    margin: 2.2rem 0 0.8rem;
    color: var(--color-ink-900);
  }
  .prose-case :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-case :global(p) {
    color: var(--color-ink-700);
    margin: 0 0 1rem;
    line-height: 1.7;
  }
  .prose-case :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: var(--color-ink-700);
  }
  .prose-case :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose-case :global(strong) {
    color: var(--color-ink-900);
  }
</style>
